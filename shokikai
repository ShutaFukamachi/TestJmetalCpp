             "j120.sm/j1206_1.sm",
            "j120.sm/j12016_1.sm",
             "j120.sm/j12026_1.sm",
             "j120.sm/j12031_1.sm",
             "j120.sm/j12036_1.sm",
             "j120.sm/j12046_1.sm",
             "j120.sm/j12051_1.sm",
             "j120.sm/j12052_1.sm",
             "j120.sm/j12056_1.sm",
             "j120.sm/j12057_1.sm",

        };

        // single instance: exe <instanceFile>
        if (argc >= 2) {
            instances.clear();
            instances.push_back(argv[1]);
        }

        const std::string outCsv = "AUGMECON_two_seeds2.csv";
        const bool newFile = !fileExists(outCsv);
        std::ofstream out(outCsv.c_str(), std::ios::app);
        if (!out) throw std::runtime_error("Cannot open output: " + outCsv);
        if (newFile) {
            out << "instanceFile,instanceId,sizeTag,seedType,nValues,values...\n";
        }

        for (const auto &instanceFile : instances) {
            const std::string sizeTag = detectSizeTag(instanceFile);
            const std::string prefix  = baseNameNoExt(instanceFile);

            if (sizeTag == "unknown") {
                throw std::runtime_error("Cannot detect sizeTag from instance path: " + instanceFile);
            }

            // この方針： instanceごとに costs_<prefix>.csv を使う
            const std::string costPath = "costs_" + prefix + ".csv";

            const auto ap = augParamsFor(sizeTag);

            cout << "====================================\n";
            cout << "[AUG-ONLY] instance=" << instanceFile << " (" << sizeTag << ")\n";
            cout << "[AUG-ONLY] costs file=" << costPath << " (must match horizon)\n";
            cout << "[AUG-ONLY] timelimit=" << ap.timelimit << " mipgap=" << ap.mipgap << "\n";
            cout << "====================================\n";

            // run AUGMECON (2 seeds) using instance-specific costs
            runAUGMECON_twoSeeds2(instanceFile, prefix, costPath, ap);

            // collect .sol and append to one CSV
            const std::string solCmax = "schedule_" + prefix + "_Cmax_opt.sol";
            const std::string solCost = "schedule_" + prefix + "_Cost_opt.sol";

            if (!fileExists(solCmax) || !fileExists(solCost)) {
                std::cerr << "[WARN] Missing .sol files for " << prefix
                          << " expected: " << solCmax << " and " << solCost << "\n";
                continue;
            }

            auto vCmax = readAllNumbers(solCmax);
            auto vCost = readAllNumbers(solCost);

            appendSeedRow(out, instanceFile, prefix, sizeTag, "Cmax_opt", vCmax);
            appendSeedRow(out, instanceFile, prefix, sizeTag, "Cost_opt", vCost);

            std::cout << "[OK] Saved both seeds to " << outCsv
                      << " for " << prefix << " (Cmax n=" << vCmax.size()
                      << ", Cost n=" << vCost.size() << ")\n";
        }

        std::cout << "[DONE] Output: " << outCsv << "\n";
        return 0;

    } catch (const std::exception &e) {
        std::cerr << "[ERROR] " << e.what() << std::endl;
        return 1;
    }
}

